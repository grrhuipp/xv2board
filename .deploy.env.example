# Copy to .deploy.env (trusted shell configuration; never commit credentials).
# Use the same PHP version/extensions and ownership as PHP-FPM.
V2BOARD_BACKUP_ROOT=/opt/lnmpr/backup
# Optional: use the actual PHP/PHAR file if `composer` is a shell wrapper.
# V2BOARD_COMPOSER=/usr/bin/composer.phar
# Required: a full, consistent SQL dump at $BACKUP_DIR/database.sql.gz.
# Docker example: credentials stay in the database container environment.
V2BOARD_BACKUP_COMMAND='docker exec mariadb sh -lc '\''exec mariadb-dump -uroot -p"$MARIADB_ROOT_PASSWORD" --single-transaction --quick --skip-lock-tables --hex-blob v2_jx'\'' | gzip > "$BACKUP_DIR/database.sql.gz"'
# Replace these commands with YOUR existing service names and site URL.
V2BOARD_RELOAD_COMMAND='systemctl reload php8.3-fpm'
# Exercise PHP through Nginx/PHP-FPM, not a static HTML page.
V2BOARD_HEALTHCHECK_COMMAND='curl --fail --silent --show-error https://YOUR_SITE/api/v1/guest/comm/config >/dev/null'
V2BOARD_HEALTH_TIMEOUT=90
